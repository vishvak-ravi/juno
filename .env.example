# This device's settings. Copy to .env (not committed) and fill in.

# The annotation model's API key (annotate.model in config.yaml is a gemini/ model).
GEMINI_API_KEY=

# The address the server listens on and this device's recorder uploads to.
# Default: 127.0.0.1.
JUNO_SERVER_HOST=

# The name this device's sessions are stored under on the server: lowercase
# letters and digits. Default: the host name, reduced to those.
JUNO_DEVICE_ID=

# The desktop client's passive agent module: the camera preview with hand
# keypoints, the gesture roles (dictate, send) and dictation. 1 turns it on.
# It needs apps/desktop/models/gesture_recognizer.task (npm run model) and,
# for dictation, apps/desktop/native/juno-dictate (npm run native, macOS).
# Default: off.
JUNO_PASSIVE_AGENT=
