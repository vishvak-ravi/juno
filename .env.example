# This computer's environment: what must be known before its settings files can
# be read or the server reached, and the models' API keys. Copy to .env (not
# committed) and fill in. Every other setting is in the client's Settings view
# (juno.config: the server's in <data_dir>/settings.json, this computer's
# recorder's in <data_dir>/device.json).

# The base directory: recorded sessions, the server's store and chats, and both
# settings files. Default: $XDG_DATA_HOME/juno, or ~/.local/share/juno.
JUNO_DATA_DIR=

# The address the server listens on; on a client, the host of the server it
# sends to. Default: 127.0.0.1.
JUNO_SERVER_HOST=

# The port the server listens on. Default: 8765.
JUNO_SERVER_PORT=

# The server this computer's recorder and Claude Code hook send to. The desktop
# client passes the address saved in its settings instead.
# Default: http://<JUNO_SERVER_HOST>:<JUNO_SERVER_PORT>.
JUNO_SERVER_URL=

# The name this computer's sessions are stored under on the server: lowercase
# letters and digits. Default: the host name, reduced to those.
JUNO_DEVICE_ID=

# On the server: the key of a gemini/ model (annotate.model, grade.model), of
# an openrouter/ model, and of TypeSafe's API, which answers keypoints.model's
# questions.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# The desktop client appends one JSON line per GET it makes to this file: the
# route, milliseconds to the headers and to the parsed body, the server's own
# milliseconds (Server-Timing) and the bytes. Default: unset, nothing written.
JUNO_TIMING_FILE=
